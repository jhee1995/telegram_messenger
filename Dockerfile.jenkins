# Jenkins LTS + Docker CLI (para que el pipeline pueda usar docker)
FROM jenkins/jenkins:lts

USER root

# Instalar Docker CLI dentro del contenedor de Jenkins
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io docker-compose \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Permitir que el usuario jenkins use el socket de Docker
RUN groupadd -f docker && usermod -aG docker jenkins

USER jenkins
