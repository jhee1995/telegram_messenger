# ─────────────────────────────────────────────────────────────────
# telegram-messenger — BACKEND .env.example
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# CORS — must match the URL where the React frontend is served
FRONTEND_URL=http://localhost:5173

# ── Telegram Bot Credentials ──────────────────────────────────────
# Obtain your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Bot API base URL (change only if using a self-hosted API server)
TELEGRAM_API_URL=https://api.telegram.org

# App secret — used for request signing / future HMAC validation
APP_SECRET=generate_a_32_char_min_random_hex_string_here
